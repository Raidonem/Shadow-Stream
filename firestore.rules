
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isFriend(userId) {
      let friendshipId = request.auth.uid < userId 
        ? request.auth.uid + "_" + userId 
        : userId + "_" + request.auth.uid;
      return isSignedIn() && exists(/databases/$(database)/documents/friendships/$(friendshipId));
    }

    function isBlockedBy(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      // Use .get() for safe field access if the field is missing
      return isSignedIn() && exists(userPath) && 
             request.auth.uid in get(userPath).data.get('blockedUserIds', []);
    }

    function isRestricted() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // Use .get() with request.time as default to safely handle missing expiration fields
      return isSignedIn() && exists(userPath) && 
             get(userPath).data.get('restrictedUntil', request.time) > request.time;
    }

    function isSuspended() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      // Use .get() with request.time as default to safely handle missing expiration fields
      return isSignedIn() && exists(userPath) && 
             get(userPath).data.get('suspendedUntil', request.time) > request.time;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || (resource != null && resource.data.get('isPublic', false) == true) || isFriend(userId) || isAdmin();
      // Allow listing public users with a limit of 50 to support the search page
      allow list: if isSignedIn() && (request.query.limit <= 50 || isAdmin()); 
      
      allow create: if isOwner(userId) 
        && request.resource.data.id == userId
        && request.resource.data.role == 'user'
        && request.resource.data.isPremium == false;

      allow update: if isAdmin() || (
        isOwner(userId) 
        && request.resource.data.id == resource.data.id
        // Prevent users from changing their own role, premium status, or moderation status fields
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'isPremium', 'suspendedUntil', 'restrictedUntil', 'createdAt', 'externalAuthId', 'email'])
      );

      allow delete: if isAdmin();

      match /history/{historyId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && !isSuspended();
      }

      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if (isSignedIn() && !isBlockedBy(userId) && !isSuspended()) || isAdmin();
      }

      match /moderation_logs/{logId} {
        allow read: if isAdmin();
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && !isSuspended() 
        && request.resource.data.userId == request.auth.uid;
      allow get, list, update, delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isAdmin();
    }

    match /avatars/{avatarId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /global_notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /anime/{animeId} {
      // Anime catalog must be publicly accessible for browsing
      allow get, list: if true;
      allow create, delete: if isAdmin();
      // Allow regular users to update only views/rating while protecting sensitive metadata
      allow update: if isAdmin() || (
        isSignedIn() && !isSuspended()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'views', 'updatedAt', 'ratingCount', 'totalRatingSum'])
      );

      match /episodes/{episodeId} {
        allow get, list: if true;
        allow create, delete: if isAdmin();
        // Allow users to update rating fields on episodes via interaction
        allow update: if isAdmin() || (
          isSignedIn() && !isSuspended()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['rating', 'ratingCount', 'totalRatingSum', 'updatedAt'])
        );

        match /comments/{commentId} {
          allow get, list: if true;
          allow create: if isSignedIn() 
            && request.resource.data.userId == request.auth.uid 
            && !isSuspended() && !isRestricted()
            && request.resource.data.text.size() <= 100;
          allow update: if (
            isSignedIn() && resource.data.userId == request.auth.uid 
            && !isSuspended() && !isRestricted()
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.text.size() <= 100
            // Protect vote counts and administrative flags from manual manipulation by comment owner
            && request.resource.data.upvotes == resource.data.upvotes
            && request.resource.data.downvotes == resource.data.downvotes
            && request.resource.data.isAdmin == resource.data.isAdmin
            && request.resource.data.isPremium == resource.data.isPremium
          ) || isAdmin();
          allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
        }
      }
    }

    match /ratings/{ratingId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid 
        && !isSuspended()
        && request.resource.data.value >= 1 && request.resource.data.value <= 10;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }

    match /comment_votes/{voteId} {
      allow read: if true;
      allow create, update: if isSignedIn() 
        && request.resource.data.userId == request.auth.uid 
        && !isSuspended()
        && (request.resource.data.type == 'up' || request.resource.data.type == 'down');
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
    
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.userIds;
      allow create: if isSignedIn() && !isSuspended()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2;
      allow delete: if isSignedIn() && request.auth.uid in resource.data.userIds;
    }

    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
      allow create: if isSignedIn() 
        && request.auth.uid == request.resource.data.senderId 
        && !isBlockedBy(request.resource.data.receiverId) 
        && !isSuspended()
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() 
        && (request.auth.uid == resource.data.receiverId || request.auth.uid == resource.data.senderId)
        && !isSuspended();
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.receiverId || request.auth.uid == resource.data.senderId);
    }
  }
}
